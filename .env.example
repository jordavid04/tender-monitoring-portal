DATABASE_URL=postgresql+psycopg2://usuario:senha@host:5432/banco
PG_SEARCH_PATH=pregao_atas,public,extensions
STORAGE_DIR=./storage
MAX_UPLOAD_MB=8
MAX_PREGAO_UPLOAD_MB=25
CNPJ_VALIDAR_DV=true
# Autenticação (integração com o login do Portal RPA)
AUTH_MODE=header            # header | jwt
AUTH_JWT_SECRET=
AUTH_JWT_ALGORITHM=HS256
AUTH_JWT_CLAIM_USER=name
AUTH_JWT_CLAIM_ROLE=role
# E-mail ao órgão
MAIL_BACKEND=console        # console (dev) | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
MAIL_FROM=licitacoes@exemplo.com.br
CORS_ORIGINS=
